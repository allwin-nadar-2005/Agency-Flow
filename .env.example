# Environment Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database Connection (Docker local or host postgres)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/project_dashboard?schema=public"

# JWT Credentials
JWT_SECRET=super-secret-access-token-key-change-in-production-12345
JWT_REFRESH_SECRET=super-secret-refresh-token-key-change-in-production-67890
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS & Cookie
FRONTEND_URL=http://localhost:5173
COOKIE_SECRET=super-secret-cookie-signing-key-34567

# Cron Schedule
OVERDUE_JOB_CRON="0 * * * *" # Every hour
